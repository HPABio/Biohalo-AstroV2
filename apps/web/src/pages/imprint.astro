---
import MainLayout from "../layouts/main.astro"
import NavBar from "../components/NavBar.astro"
import Footer from "../components/Footer.astro"
---

<MainLayout title="Imprint | BioHalo">
  <NavBar />

  <main class="min-h-screen relative overflow-hidden py-16 md:py-24">
    <!-- Background layers -->
    <div class="absolute inset-0 -z-20">
      <div class="absolute inset-0">
        <img
          src="https://framerusercontent.com/images/jDstuQwhf2SzTvmqF9d4STgqd5E.svg"
          class="h-full w-full scale-150 object-fill object-center opacity-50"
          alt=""
        />
      </div>
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.03]"
        style="background: radial-gradient(ellipse 60% 50% at 50% 40%, oklch(0.5 0 0 / 0.08) 0%, transparent 70%);"
      ></div>
    </div>

    <div class="pt-32 pb-20 px-4 md:px-8 lg:px-16 container mx-auto relative z-10">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-display font-bold mb-8 pb-6 title-gradient">
          Imprint
        </h1>

        <div class="rounded-xl p-6 md:p-8 bg-gradient-to-br from-card to-card/50 ring-1 ring-border/50">
          <section class="mb-8">
            <h2 class="text-2xl font-semibold mb-4 text-foreground">
              Company Information
            </h2>
            <div class="text-muted-foreground leading-relaxed space-y-1">
              <p class="font-medium text-foreground">BioHalo ApS</p>
              <p>Rentemestervej 3</p>
              <p>2200 København, Denmark</p>
            </div>
          </section>

          <section class="mb-8">
            <h2 class="text-2xl font-semibold mb-4 text-foreground">
              Contact Details
            </h2>
            <div class="text-muted-foreground leading-relaxed space-y-1">
              <p>Email: <a href="mailto:info@biohalo.io" class="text-primary hover:text-primary/80 transition-colors">info@biohalo.io</a></p>
              <p>Website: <a href="https://www.biohalo.io" class="text-primary hover:text-primary/80 transition-colors">www.biohalo.io</a></p>
            </div>
          </section>

          <section class="mb-8">
            <h2 class="text-2xl font-semibold mb-4 text-foreground">
              Management
            </h2>
            <div class="text-muted-foreground leading-relaxed">
              <p>BioHalo is represented by its management team.</p>
            </div>
          </section>

          <section class="mb-8">
            <h2 class="text-2xl font-semibold mb-4 text-foreground">
              Legal Identification
            </h2>
            <div class="text-muted-foreground leading-relaxed space-y-1">
              <p>Registered in Denmark</p>
              <!-- <p>VAT Identification Number: [INSERT VAT NUMBER]</p> -->
              <!-- <p>Company Registration Number (CVR): [INSERT CVR NUMBER]</p> -->
            </div>
          </section>

          <section>
            <h2 class="text-2xl font-semibold mb-4 text-foreground">
              Disclaimer
            </h2>
            <p class="text-muted-foreground leading-relaxed italic">
              The information on this website is for general information purposes only. While we strive to keep the information up to date and correct, we make no representations or warranties of any kind about the completeness, accuracy, or reliability of the information.
            </p>
          </section>
        </div>
      </div>
    </div>
  </main>
</MainLayout>
