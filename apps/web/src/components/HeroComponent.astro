---
import ColorBends from "./BackGroundAnimation/ColorBends.tsx"
import Hero from "./Hero.astro";
---
<section class="relative h-screen w-screen bg-black">
	<div class="inset-0">
		<!-- colors={["#ADDEDE", "#1D5566", "#00ffd1"]}
		colors={["#ADDEDE", "#1D5566", "#00ffd1"]} -->
		<ColorBends
			client:load
			className="absolute bottom-0 right-0 w-full h-full blur-lg scale-150 rotate-180"
			colors={["#1D5566", "#ADDEDE", "#59A2AE"]}
			rotation={0}
			speed={0.2}
			scale={1}
			frequency={1.05 /* Good values are 1.02, 1.03, 1.04 */}
			warpStrength={1 /* Good values are 1, 1.1, 1.2 */}
			mouseInfluence={0.35}
			parallax={0}
			noise={0.1}
			transparent={true}
		/>

		<!-- Background Gradient to top -->
		<div
			class="absolute bottom-0 left-0 h-[50vh] w-screen overflow-hidden bg-linear-to-t from-black to-transparent "
		>
		</div>

    

	</div>

	<!-- Hero Section with backdrop blur -->
	<div
		class="absolute top-0 left-0 h-screen w-screen overflow-hidden bg-black/20 flex items-start justify-center">
		<!-- Noise texture -->
		<div
		class="pointer-events-none absolute inset-0 opacity-[0.15]"
		style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E'); background-repeat: repeat; background-size: 256px 256px;"
		>
		</div>
		
		<div class="relative overflow-hidden flex items-center justify-center">
			<Hero />
		</div>
	</div>
</section>
