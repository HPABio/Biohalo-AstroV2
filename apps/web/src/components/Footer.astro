---
import logo from "../assets/images/BioHaloLogo.png"
import euCoFinancingBanner from "../assets/provided_materials/Provided_Materials/EU-bz2-logofrise.png"

const columns = [
  {
    title: "Our Solutions",
    links: [
      { label: "Start", href: "/" },
      { label: "Problem", href: "/#problem" },
      { label: "Solution", href: "/#solution" },
      // { label: "Team", href: "/#team" },
    ],
  },
  // {
  //   title: "Company",
  //   links: [
  //     { label: "About", href: "#" },
  //     // { label: "Team", href: "#team" },
  //     // { label: "Careers", href: "#" },
  //   ],
  // },
  // {
  //   title: "Resources",
  //   links: [
  //     { label: "Publications", href: "#" },
  //     { label: "Patents", href: "#" },
  //     { label: "Press", href: "#" },
  //   ],
  // },
  {
    title: "Legal",
    links: [
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
      { label: "Imprint", href: "/imprint" },
    ],
  },
]
---

<footer class="relative border-t border-border/50">
  <div class="mx-auto max-w-screen-xl px-6 py-16 md:py-24">
    <div class="grid gap-8 md:grid-cols-6">
      <!-- Brand -->
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2">
          <img
            src={logo.src}
            alt="BioHalo"
            width={logo.width}
            height={logo.height}
            class="h-9 w-auto"
          />
          <span
            class="font-display text-lg font-semibold tracking-tight text-foreground"
            >BioHalo</span
          >
        </a>
        <p class="mt-4 max-w-xs text-sm text-muted-foreground">
          Pioneering sustainable marine chemistry through microbial
          biofluorination. Founded in Denmark, 2023.
        </p>
      </div>

      {
        columns.map((col) => (
          <div>
            <h4 class="mb-3 text-sm font-medium text-foreground">
              {col.title}
            </h4>
            <ul class="flex flex-col gap-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="my-8 h-px w-full bg-border"></div>

    <div
      class="mb-8 flex flex-col items-center gap-3 border border-border/40 bg-black px-4 py-6 md:px-6"
      role="region"
      aria-label="EU co-financing"
    >
      <p class="text-center text-xs font-medium text-white/90">
        Co-financed by the European Union
      </p>
      <img
        src={euCoFinancingBanner.src}
        alt="EU co-financing and partner logos: Biosolutions Zealand, European Union, Erhvervsfyrtårn Biosolutions."
        width={euCoFinancingBanner.width}
        height={euCoFinancingBanner.height}
        class="h-auto w-full max-w-4xl object-contain"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
      <p class="text-xs text-muted-foreground">
        &copy; {new Date().getFullYear()} BioHalo ApS. All rights reserved.
      </p>
      <p class="text-xs text-muted-foreground">Copenhagen, Denmark</p>
    </div>
  </div>
</footer>
